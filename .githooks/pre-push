#!/usr/bin/env bash
# nevr-proto pre-push: backward-compatibility gate. THIS ONE BLOCKS.
#
# WHY IT BLOCKS HERE WHEN OTHER REPOS MUST NOT:
#   A gate is derived from what the push DOES and what a mistake COSTS, never
#   from the shape of the thing it sits on. In a working repo, pushing is the
#   safety mechanism -- committed work survives a dead machine, and blocking the
#   push strands you on old code. Here, a push to main is PUBLICATION to
#   buf.build/echotools/nevr-api, which other repositories fetch. The risk is not
#   losing work, it is PROPAGATION, and a follow-up commit cannot un-consume a
#   module someone already pulled.
#
# WHAT THIS BUYS THAT CI DOES NOT, stated honestly rather than oversold:
#   CI runs the breaking check and the publish as sequential steps in one job, so
#   CI already protects the REGISTRY -- a failing check means no publish. What CI
#   cannot protect is MAIN ITSELF. There is no branch protection on this repo and
#   no PR requirement, so a bad commit is on origin/main the instant you push,
#   even if the publish is correctly blocked afterwards. This hook is the only
#   thing that stops it before it is public.
#
# BEING OFFLINE IS NOT A VIOLATION. If the registry is unreachable this says so
# loudly and lets the push through. You should not be blocked on a plane.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GATE="$REPO_ROOT/scripts/breaking-gate.sh"
[ -x "$GATE" ] || { echo "pre-push: $GATE missing or not executable" >&2; exit 1; }

ZERO='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # Deleting a remote ref publishes nothing.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git rev-parse -q --verify origin/main 2>/dev/null || echo '')"
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Only a push to main publishes. A branch push is checked and REPORTED but does
  # not block, because nothing downstream consumes it -- same derivation, applied
  # to a push that does something different.
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: $remote_ref -> publication. Checking compatibility." >&2
    "$GATE" --target registry --commits "$range" --offline-ok || status=1
  else
    echo "pre-push: $remote_ref does not publish; checking for information only." >&2
    "$GATE" --target registry --commits "$range" --offline-ok || \
      echo "pre-push: NOT BLOCKING -- this ref does not publish. It will block when it reaches main." >&2
  fi
done

exit $status
